# Copia questo file in .env.local (gitignored, mai committato) e compila i valori reali.
# Prendili da Firebase Console > Project Settings > General > Your apps > SDK config.
# Su Vercel: stessi nomi come Environment Variables del progetto.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
# Solo in locale: in produzione (Vercel) lasciala NON impostata, si usa il dominio dell'app.
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="MY_MEASUREMENT_ID"
# Usato per il rinnovo silenzioso del token Sheets/Drive (Google Identity Services,
# vedi frontend/src/lib/googleAuth.ts). Google Cloud Console > APIs & Services > Credentials >
# "OAuth 2.0 Client IDs" > il client Web auto-creato da Firebase per questo progetto.
VITE_GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
# Opzionale: ID dello Google Sheet precaricato al primo avvio (altrimenti si imposta da Impostazioni).
VITE_DEFAULT_SPREADSHEET_ID=""
# Opzionale: ID del foglio "finanza_data_config" (Dati Base), precaricato al primo avvio.
VITE_DEFAULT_CONFIG_SPREADSHEET_ID=""

# --- Sincronizzazione bancaria (backend Python in backend/, solo lato server) ---
# Per provare il backend in locale (npm run api) mettile anche in .env.local.
# Su Vercel: Settings > Environment Variables. NON hanno il prefisso VITE_, quindi
# non finiscono mai nel browser. Le funzioni usano anche VITE_DEFAULT_SPREADSHEET_ID
# e VITE_DEFAULT_CONFIG_SPREADSHEET_ID qui sopra (stessi fogli dell'app).
# Enable Banking (enablebanking.com > Control Panel > API applications): Application ID.
EB_APP_ID="MY_ENABLE_BANKING_APPLICATION_ID"
# Contenuto del file .pem scaricato alla registrazione dell'applicazione (tutto, comprese
# le righe BEGIN/END). Solo in locale (scripts/banca.ts) si usa invece il percorso del file:
EB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
EB_KEY_PATH=".banca/MY_ENABLE_BANKING_APPLICATION_ID.pem"
# Uguale a uno degli "Allowed redirect URLs" dell'applicazione su Enable Banking.
EB_REDIRECT_URL="https://MY_DOMAIN/api/banca/callback"
# Chiave JSON del service account Google (wally-sync@...iam.gserviceaccount.com), tutto
# il contenuto del file. I due fogli vanno condivisi con la sua email come Editor.
GOOGLE_SA_KEY='{"type":"service_account", ...}'
# Password casuale (es. `openssl rand -hex 32`): la manda il cron di Vercel per lanciare
# la sincronizzazione notturna e firma il collegamento con la banca. Non serve ricordarla.
CRON_SECRET="MY_RANDOM_SECRET"
