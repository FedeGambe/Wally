# Copia questo file in .env.local (gitignored, mai committato) e compila i valori reali.
# Prendili da Firebase Console > Project Settings > General > Your apps > SDK config.
# Su Vercel: stessi nomi come Environment Variables del progetto.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="MY_MEASUREMENT_ID"
