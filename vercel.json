{
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://wally-fin.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://wally-fin.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/**,docs/**,scripts/**,backend/tests/**,.impeccable/**}"
    }
  },
  "crons": [
    {
      "path": "/api/banca/sincronizza",
      "schedule": "0 4 * * *"
    }
  ]
}
